        {
          "$ref": "#/$defs/assertion",
          "properties": {
            "value": {
              "type": "string"
            }
          }
        }
      ],
      "x-clio-section": "identity",
      "x-clio-sensitivity": "public",
      "x-clio-requiredAt": "draft",
      "x-clio-termIri": "http://purl.org/dc/terms/title"
    },
    "observedOn": {
      "title": "Date",
      "description": "The day you saw or collected it (YYYY-MM-DD). If you're not sure of the day, give a range such as 2026-10-01/2026-10-03.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:0[048]|[2468][048]|[13579][26])00)-02-29)(?:/(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:0[048]|[2468][048]|[13579][26])00)-02-29))?$"
        },
        {
          "$ref": "#/$defs/assertion",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:0[048]|[2468][048]|[13579][26])00)-02-29)(?:/(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:0[048]|[2468][048]|[13579][26])00)-02-29))?$"
            }
          }
        }
      ],
      "x-clio-section": "event",
      "x-clio-sensitivity": "public",
      "examples": [
        "2026-10-22"
      ],
      "x-clio-requiredAt": "draft",
      "x-clio-termIri": "http://rs.tdwg.org/dwc/terms/eventDate"
    },
    "locality": {
      "title": "Place",
      "description": "Describe the place in words. Keep it general if the exact spot could put a species, site or person at risk.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/assertion",
          "properties": {
            "value": {
              "type": "string"
