        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/assertion",
          "properties": {
            "value": {
              "type": "string"
            }
          }
        }
      ],
      "x-clio-section": "provenance",
      "x-clio-sensitivity": "public",
      "x-clio-requiredAt": "draft",
      "x-clio-termIri": "http://rs.tdwg.org/dwc/terms/recordedBy"
    },
    "description": {
      "title": "What you saw or did",
      "description": "Describe what you observed. Keep what you saw separate from what you think it means.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/assertion",
          "properties": {
            "value": {
              "type": "string"
            }
          }
