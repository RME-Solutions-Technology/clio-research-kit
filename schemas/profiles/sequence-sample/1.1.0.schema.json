      "x-clio-section": "method",
      "x-clio-sensitivity": "public",
      "x-clio-requiredAt": "referenceable"
    },
    "rightsLicense": {
      "title": "Licence",
      "description": "Records use CC BY 4.0 unless the package says otherwise. Use the licence URI.",
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "$ref": "#/$defs/assertion",
          "properties": {
            "value": {
              "type": "string",
              "format": "uri"
            }
          }
