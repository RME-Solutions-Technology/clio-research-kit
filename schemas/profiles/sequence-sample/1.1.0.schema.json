{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clio:schema:sequence-sample:1.1.0",
  "$comment": "SPDX-License-Identifier: CC-BY-4.0. See schemas/LICENSE. Generated by scripts/generate-schemas.ts; do not edit by hand.",
  "title": "Sequence sample",
  "description": "A water, eDNA or other sample linked to sequencing, with site, depth, environment, filtering, controls, target gene and accessions.",
