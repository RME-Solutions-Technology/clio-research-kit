      "x-clio-sensitivity": "sensitive",
      "x-clio-requiredAt": "draft",
      "x-clio-termIri": "http://rs.tdwg.org/dwc/terms/locality"
    },
    "observer": {
      "title": "Observer or collector",
      "description": "Who saw or collected it. This can be you.",
