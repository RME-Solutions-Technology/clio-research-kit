      "x-clio-section": "rights",
      "x-clio-sensitivity": "public",
      "x-clio-requiredAt": "referenceable",
      "x-clio-termIri": "http://purl.org/dc/terms/license",
      "default": "https://creativecommons.org/licenses/by/4.0/"
    },
    "sourceReference": {
      "title": "Source",
      "description": "Where the evidence comes from: your field notebook, a project, an instrument log or a publication.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/assertion",
          "properties": {
            "value": {
              "type": "string"
            }
          }
        }
