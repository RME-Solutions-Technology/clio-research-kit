      "x-clio-section": "provenance",
      "x-clio-sensitivity": "public",
      "x-clio-requiredAt": "research_ready"
    },
    "uncertaintyNote": {
      "title": "What's uncertain",
      "description": "Say what is uncertain, estimated or missing. Write 'none known' if nothing is.",
