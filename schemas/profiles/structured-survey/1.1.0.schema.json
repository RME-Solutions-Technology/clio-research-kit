        "decimalLatitude",
        "decimalLongitude",
        "coordinateUncertaintyM",
        "geodeticDatum"
      ]
    },
    "countStatus": {
      "count": "eventCount",
      "status": "occurrenceStatus",
      "present": "detected",
      "absent": "notDetected"
    },
    "conditional": [
      {
        "when": {
          "field": "occurrenceStatus",
          "in": [
            "notDetected"
          ]
        },
        "require": [
          "targetTaxonomicScope",
          "samplingEffort"
        ],
        "message": "A 'not detected' record needs the target group and your effort."
      },
      {
        "when": {
          "field": "occurrenceStatus",
          "in": [
            "notDetected"
          ]
        },
        "restrict": {
          "field": "isAbsenceReported",
          "in": [
            true
          ]
        },
        "message": "A 'not detected' record means you report absences. Set 'Do you report what you didn't find?' to Yes."
      }
    ]
  }
}
