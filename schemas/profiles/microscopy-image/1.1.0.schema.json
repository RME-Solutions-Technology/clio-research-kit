  "x-clio-launchable": true,
  "x-clio-conformanceClaim": "none",
  "x-clio-readinessLevels": [
    "draft",
    "referenceable",
    "research_ready",
    "curator_reviewed",
    "doi_ready",
    "archive_accepted"
  ],
  "x-clio-requiredBy": {
    "draft": [
      "title",
      "observedOn",
      "locality",
      "observer"
    ],
    "referenceable": [
      "method",
      "rightsLicense",
      "uncertaintyNote",
      "specimenIdentifier",
      "specimenKind",
      "scaleEvidence"
    ],
    "research_ready": [
      "sourceReference",
      "samplePreparation",
      "microscopeManufacturer",
      "microscopeModel",
      "objectiveMagnification",
      "illumination",
      "imagingMethod",
      "pixelSize",
      "pixelSizeCalibrationMethod"
    ],
    "curator_reviewed": [
      "curatorReviewReference"
    ],
    "doi_ready": [
      "citationText",
      "qualityStatement"
    ],
    "archive_accepted": [
      "archivePackageReference"
    ]
  },
  "x-clio-standardReferences": [
    {
      "name": "REMBI"
    },
    {
      "name": "OME"
    }
  ],
  "x-clio-qualityChecks": {
    "ruleSet": "clio.lane-checks/1.0.0",
    "errorFrom": "referenceable",
    "rejectFutureDates": true,
    "requireTimeZoneOffset": true,
    "enforcePatterns": true,
    "positiveValues": [
      "pixelSize",
      "zStep"
    ],
    "conditional": [
      {
        "when": {
          "field": "specimenKind",
          "in": [
            "biological"
          ]
        },
        "from": "research_ready",
        "require": [
          "organismScientificName",
          "biologicalEntity"
        ],
        "message": "For a biological specimen, add the organism and the part shown."
      },
      {
        "when": {
          "field": "scaleEvidence",
          "in": [
            "no_scale"
          ]
        },
        "from": "research_ready",
        "restrict": {
          "field": "pixelSizeCalibrationMethod",
          "in": [
            "nominal_from_magnification",
            "none"
          ]
        },
        "message": "With no scale in the image, the pixel size can only be nominal. Add a micrometer or scale-bar photo to calibrate it."
      }
    ]
  }
