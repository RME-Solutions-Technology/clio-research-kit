{
  "name": "@clio-museum/research-kit",
  "version": "0.1.0",
  "description": "Pre-1.0. Darwin Core Archive, BagIt and RO-Crate research packaging, field-lane schemas and a CSV/JSON/NDJSON importer, extracted from Clio Online Museum.",
  "private": true,
  "author": "RME Solutions Technology",
  "homepage": "https://github.com/RME-Solutions-Technology/clio-research-kit#readme",
  "bugs": {
    "url": "https://github.com/RME-Solutions-Technology/clio-research-kit/issues"
  },
  "type": "module",
  "license": "Apache-2.0 AND CC-BY-4.0",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "schemas",
    "docs",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CITATION.cff",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "AUDIT.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "schemas:generate": "node scripts/generate-schemas.ts",
    "schemas:check": "node scripts/generate-schemas.ts --check",
    "check:imports": "node scripts/check-imports.ts",
    "check:scrub": "node scripts/scrub-check.ts",
    "sbom": "node scripts/generate-sbom.ts",
    "vectors": "node scripts/generate-vectors.ts",
    "vectors:check": "node scripts/generate-vectors.ts --check",
    "validators": "node scripts/run-validators.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "check:package": "node scripts/check-package.ts",
    "export:public": "node scripts/export-public.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RME-Solutions-Technology/clio-research-kit.git"
  }
}
